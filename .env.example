# Copia a .env antes de levantar: 'cp .env.example .env'
# Sin defaults para los secretos a proposito: mejor que falle rapido y claro
# a que arranque con una credencial conocida.

# UID/GID del usuario del host, para que los archivos generados dentro del
# contenedor (target/, .m2repo/) no queden de root. Obtenlos con: id -u; id -g
HOST_UID=1000
HOST_GID=1000

# Base de datos
DB_NAME=starter
DB_USER=starter
DB_PASSWORD=cambiame
